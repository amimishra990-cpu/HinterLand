# Public Supabase configuration (safe for the browser).
# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Canonical site origin used for email redirect links.
# Local: http://localhost:3000
# Production: your deployed origin, e.g. https://hinterland.example
# Must match the Supabase Site URL and redirect allowlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Do NOT prefix these with NEXT_PUBLIC_.
# The application does not require a service-role key; keep it out of this app.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider configuration (server-only)
# ---------------------------------------------------------------------------
# The AI routes stay unavailable until AI_PROVIDER, AI_MODEL, and an API key
# are all set. Keys are read only on the server.
#
# AI_PROVIDER: openai | openai-compatible | anthropic
AI_PROVIDER=openai

# Use AI_API_KEY, or the provider-specific fallback (OPENAI_API_KEY /
# ANTHROPIC_API_KEY). Never expose this value to the browser.
AI_API_KEY=

# Required. Examples: gpt-4.1-mini (OpenAI), claude-sonnet-4-5 (Anthropic).
AI_MODEL=

# Required only for openai-compatible endpoints. Must be HTTPS
# (http://localhost is allowed for local testing).
# AI_BASE_URL=https://your-gateway.example.com/v1

# Optional tuning. Defaults shown.
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_MAX_OUTPUT_TOKENS=3000
# AI_TEMPERATURE=0.2
# AI_REQUESTS_PER_HOUR=40
# AI_JSON_MODE=true
# AI_CONTEXT_CHARS=24000
# AI_CACHE_TTL_MS=300000
